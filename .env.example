# AWS Bedrock (required for Strands agents)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# MiniMax API (TTS + Image generation)
MINIMAX_API_KEY=

# TestSprite (code validation)
TESTSPRITE_API_KEY=

# Datadog (observability)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=hackathon
DD_PROFILING_MEMORY_ENABLED=false

# OpenTelemetry (Strands auto-exports traces)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=learnforge-agents
